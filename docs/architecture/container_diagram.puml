@startuml ContainerDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Диаграмма контейнеров системы "BookingForStudents" (C4 Level 2)

' === Акторы (люди) ===
Person(student, "Студент", "Просматривает слоты, записывается, отменяет запись, встаёт в лист ожидания")
Person(teacher, "Преподаватель", "Создаёт и редактирует слоты, смотрит записавшихся и лист ожидания")
Person(admin, "Администратор", "Управляет пользователями и справочниками")

' === Контейнеры внутри системы ===
Container(webui, "Web UI", "HTML, CSS, JavaScript", "Веб-интерфейс для студентов, преподавателей и администраторов. Отображает расписание, формы записи, личный кабинет")
Container(api, "Backend API", "Python, Django + DRF", "REST API, бизнес-логика: аутентификация, управление слотами, записями, листом ожидания, постановка задач на отправку уведомлений")
ContainerDb(db, "База данных", "PostgreSQL 16", "Хранение пользователей, слотов, записей, листа ожидания, истории действий")
Container(broker, "Брокер сообщений", "Redis", "Очередь задач для фоновой обработки email-уведомлений")
Container(worker, "Background Worker", "Python, Celery", "Асинхронная отправка email-уведомлений: подтверждения, напоминания, приглашения из листа ожидания")

' === Внешние системы ===
System_Ext(email, "Email-сервис (SMTP)", "Отправляет письма студентам и преподавателям")

' === Взаимодействия акторов с системой ===
Rel(student, webui, "Использует", "HTTPS")
Rel(teacher, webui, "Использует", "HTTPS")
Rel(admin, webui, "Использует", "HTTPS")

' === Внутренние взаимодействия контейнеров ===
Rel(webui, api, "Вызывает REST API", "JSON / HTTPS")
Rel(api, db, "Читает и пишет данные", "SQL / psycopg")
Rel(api, broker, "Ставит задачи на отправку email", "Redis protocol")
Rel(broker, worker, "Передаёт задачи", "Redis protocol")
Rel(worker, email, "Отправляет email", "SMTP")

@enduml