@startuml ContextDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекстная диаграмма системы "BookingForStudents"

' === Акторы (люди) ===
Person(student, "Студент", "Просматривает доступные слоты, записывается на мероприятия и консультации, отменяет запись (не позднее чем за 2 часа), при отсутствии мест встаёт в лист ожидания")
Person(teacher, "Преподаватель", "Создаёт и редактирует слоты (включая повторяющиеся), указывает формат (офлайн/онлайн/гибрид), лимит участников, просматривает список записавшихся и лист ожидания")
Person(admin, "Администратор", "Управляет учётными записями пользователей, справочниками и модерирует содержимое системы")

' === Система (чёрный ящик) ===
System(booking, "BookingForStudents", "Информационная система записи студентов на мероприятия и консультации. Централизует расписание, автоматизирует учёт записавшихся, поддерживает лист ожидания и уведомления")

' === Внешние системы ===
System_Ext(email, "Email-сервис (SMTP)", "Отправляет студентам и преподавателям уведомления: подтверждение записи, отмена, напоминание о мероприятии, приглашение из листа ожидания")

' === Взаимодействия ===
Rel(student, booking, "Просматривает слоты, записывается, отменяет запись, встаёт в лист ожидания", "HTTPS / Web UI")
Rel(teacher, booking, "Создаёт и редактирует слоты, смотрит записавшихся и лист ожидания", "HTTPS / Web UI")
Rel(admin, booking, "Управляет пользователями и справочниками", "HTTPS / Web UI")

Rel(booking, email, "Отправляет уведомления о записи, отмене, напоминания", "SMTP")

@enduml